{
  "name": "tryunex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --workspace backend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "build": "npm --workspace backend run build && npm --workspace frontend run build",
    "vercel-build": "npm --workspace frontend run build",
    "install:all": "npm install",
    "db:push": "npm --workspace backend run db:push"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
