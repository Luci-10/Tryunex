{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/|uploads/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[[...path]].ts": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
