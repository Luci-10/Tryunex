{
  "name": "tryunex-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "find drizzle -name '._*' -delete 2>/dev/null; COPYFILE_DISABLE=1 drizzle-kit generate",
    "db:push": "find drizzle -name '._*' -delete 2>/dev/null; COPYFILE_DISABLE=1 drizzle-kit generate && tsx src/scripts/db-bootstrap.ts",
    "verify:billing": "node --env-file=.env scripts/verify-billing.mjs",
    "verify:thrift": "node --env-file=.env scripts/verify-thrift.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@neondatabase/serverless": "^0.10.4",
    "@vercel/blob": "^0.27.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.1",
    "jose": "^5.9.6",
    "multer": "^2.0.0",
    "nodemailer": "^8.0.9",
    "undici": "^7.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.1",
    "pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
