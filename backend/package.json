{
  "name": "tryunex-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "find drizzle -name '._*' -delete 2>/dev/null; COPYFILE_DISABLE=1 drizzle-kit generate",
    "db:push": "find drizzle -name '._*' -delete 2>/dev/null; COPYFILE_DISABLE=1 drizzle-kit generate && tsx src/scripts/db-bootstrap.ts",
    "verify:billing": "node --env-file=.env scripts/verify-billing.mjs",
    "verify:thrift": "node --env-file=.env scripts/verify-thrift.mjs",
    "verify:tryon": "node --env-file=.env scripts/verify-tryon-credits.mjs",
    "verify:media": "node --env-file=.env scripts/verify-media.mjs",
    "audit:images": "node --env-file=.env scripts/audit-image-storage.mjs",
    "verify:policy": "node --env-file=.env scripts/verify-policy.mjs",
    "verify:age": "node --env-file=.env scripts/verify-age.mjs",
    "verify:transfer": "node --env-file=.env scripts/verify-thrift-transfer.mjs",
    "verify:notifications": "node --env-file=.env scripts/verify-notifications.mjs",
    "verify:wear": "node --env-file=.env scripts/verify-wear.mjs",
    "verify:deletion": "node --env-file=.env scripts/verify-deletion.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "@neondatabase/serverless": "^0.10.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.1",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.1",
    "pg": "^8.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
