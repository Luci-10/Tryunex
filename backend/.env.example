# Neon Postgres
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# JWT signing secret (generate with: openssl rand -hex 48)
JWT_SECRET=replace-with-a-long-random-string

# Gmail SMTP (the address that will send OTPs)
#   1) Enable 2-Step Verification on your Google account
#   2) Generate an App Password: https://myaccount.google.com/apppasswords
#   3) Paste the 16-char app password (no spaces) below
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# CORS origin for the Vite frontend (dev only)
FRONTEND_ORIGIN=http://localhost:5173

# Server port (dev only)
PORT=3001

# Vercel Blob (production photo storage). Leave unset locally to fall back to disk.
# BLOB_READ_WRITE_TOKEN=

# Razorpay — payments and subscriptions (INR).
# Dashboard → Settings → API Keys. The secret and webhook secret must never
# reach the frontend; only KEY_ID is sent to the browser for checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Recurring plan ids, created in Dashboard → Subscriptions → Plans.
# Monthly, INR, amounts must match backend/src/services/billing/catalogue.ts:
#   Lite ₹55 / Plus ₹99 / Style ₹199
RAZORPAY_PLAN_LITE_ID=
RAZORPAY_PLAN_PLUS_ID=
RAZORPAY_PLAN_STYLE_ID=

# Optional: pause all fresh Try-on generation without a code change.
# TRYON_GENERATION_DISABLED=1
